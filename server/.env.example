# ===================================================
# PresenceX Backend Server Configuration (Template)
# Copy this file to .env and configure your values.
# ===================================================

# --- Node Environment ---
NODE_ENV=development

# --- Engine Server (Load Balancer) ---
ENGINE_PORT=5000
PORT=5000

# --- Normal Worker Servers Ports ---
NORMAL_SERVER_1_PORT=5001
NORMAL_SERVER_2_PORT=5002
NORMAL_SERVER_3_PORT=5003

# --- Hostname for inter-server communication & health checks ---
SERVER_HOSTNAME=127.0.0.1

# --- Health Check Configuration ---
HEALTH_CHECK_PATH=/health
HEALTH_CHECK_TIMEOUT=2000
HEALTH_CHECK_INTERVAL=5000

# --- Request Proxy Timeout (milliseconds) ---
REQUEST_TIMEOUT=10000

# --- CORS Allowed Origins (Comma-separated) ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- Admin Security Authentication Key ---
# Must match VITE_ADMIN_KEY in client configuration
ADMIN_KEY=your_admin_secret_key_here

# --- MongoDB Database Connection URI ---
# For local MongoDB:
MONGO_URI=mongodb://localhost:27017/presencex
# For MongoDB Atlas (Cloud):
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
