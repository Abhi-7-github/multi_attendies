# ===================================================
# PresenceX Frontend Configuration (Template)
# Copy this file to .env and configure your values.
# ===================================================

# Main API Backend URL (Engine Server Load Balancer)
# Local Development: http://localhost:5000
# Production: e.g. https://presencex-backend.onrender.com
VITE_API_BASE_URL=http://localhost:5000

# Admin Dashboard Authentication Key
# Must match ADMIN_KEY on the backend server
VITE_ADMIN_KEY=your_admin_secret_key_here

# Direct Server URLs (Optional - defaults to localhost ports)
VITE_ENGINE_SERVER_URL=http://localhost:5000
VITE_NORMAL_SERVER_1_URL=http://localhost:5001
VITE_NORMAL_SERVER_2_URL=http://localhost:5002
VITE_NORMAL_SERVER_3_URL=http://localhost:5003
